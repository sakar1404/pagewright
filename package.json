{
  "name": "pagewright",
  "productName": "Pagewright",
  "version": "1.0.0",
  "description": "Desktop PDF editor: view, annotate, edit text and images, organize pages, merge, split, convert, compress.",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite build && electron .",
    "build": "vite build",
    "start": "vite build && electron .",
    "typecheck": "tsc --noEmit",
    "screens": "vite build && node tests/capture-screens.ts",
    "test:engine": "node --test tests/engine.test.ts",
    "test:ui": "vite build && node tests/ui.e2e.ts",
    "test": "npm run typecheck && npm run test:engine && npm run test:ui",
    "dist": "vite build && electron-builder --win --x64"
  },
  "dependencies": {
    "mupdf": "1.28.1"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.0.12",
    "playwright": "1.64.1",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  },
  "build": {
    "appId": "local.pagewright.app",
    "files": ["dist/**", "electron/**", "package.json"],
    "directories": { "output": "release" },
    "fileAssociations": [{ "ext": "pdf", "name": "PDF Document" }],
    "win": { "target": "nsis", "signAndEditExecutable": false },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
